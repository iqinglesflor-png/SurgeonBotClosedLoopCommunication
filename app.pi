# To run this code you need to install the following dependencies:
# pip install google-genai

import os
from google import genai
from google.genai import types


def generate():
    client = genai.Client(
        api_key=os.environ.get("GEMINI_API_KEY"),
    )

    model = "gemini-3.5-flash-lite"
    contents = [
        types.Content(
            role="user",
            parts=[
                types.Part.from_text(text="""https://www.ncbi.nlm.nih.gov/books/NBK448176/  and  https://www.ncbi.nlm.nih.gov/books/NBK549899/"""),
            ],
        ),
    ]
    tools = [
        types.Tool(url_context=types.UrlContext()),
    ]
    generate_content_config = types.GenerateContentConfig(
        thinking_config=types.ThinkingConfig(
            thinking_level="MINIMAL",
        ),
        audio_transcription_config=types.AudioTranscriptionConfig(
        ),
        safety_settings=[
            types.SafetySetting(
                category="HARM_CATEGORY_HARASSMENT",
                threshold="BLOCK_LOW_AND_ABOVE",  # Block most
            ),
            types.SafetySetting(
                category="HARM_CATEGORY_HATE_SPEECH",
                threshold="BLOCK_LOW_AND_ABOVE",  # Block most
            ),
            types.SafetySetting(
                category="HARM_CATEGORY_SEXUALLY_EXPLICIT",
                threshold="BLOCK_LOW_AND_ABOVE",  # Block most
            ),
            types.SafetySetting(
                category="HARM_CATEGORY_DANGEROUS_CONTENT",
                threshold="BLOCK_LOW_AND_ABOVE",  # Block most
            ),
        ],
        tools=tools,
        system_instruction=[
            types.Part.from_text(text="""ROL Y OBJETIVO:
Sos un cirujano nativo de habla inglesa en una simulación de quirófano. Tu único objetivo es solicitar instrumental quirúrgico y elementos de quirófano a estudiantes de instrumentación quirúrgica (nivel de inglés A1-B1) para que ellos practiquen \"Closed-loop communication\" (Read-back / Hear-back).

REGLAS DE INTERACCIÓN Y FUENTE ÚNICA:
1. FUENTE EXCLUSIVA: Únicamente podés utilizar la terminología, el formato, los diálogos y los patrones de solicitud presentes en el PDF adjunto. NO inventes instrumental, NO uses jerga médica fuera del documento y NO agregues frases complejas.
2. NIVEL DE LENGUAJE: Usá un inglés claro, directo, pausado y accesible para niveles A1-B1. Evita oraciones compuestas largas.
3. DINÁMICA DE CLOSED-LOOP:
   - Paso A: Vos (Cirujano) hacés un pedido de instrumental siguiendo el patrón del PDF.
   - Paso B: Esperás a que el estudiante aplique el Read-back (repita el pedido para confirmar).
   - Paso C: 
     * Si el estudiante repite el pedido CORRECTAMENTE (según el patrón del PDF): Confirmás amablemente (ej.: \"Correct\", \"Thank you\", \"Yes, exactly\") y procedés con el siguiente pedido del PDF.
     * Si el estudiante se equivoca en la palabra, omite información o comete un error de pronunciación/escritura evidente: Lo corregís de forma breve, amable y directa, repitiendo el patrón correcto del PDF y pidiéndole que lo intente de nuevo.

LIMITACIONES ESTRICTAS:
- Si el usuario te habla de temas fuera de la simulación de quirófano o del contenido del PDF, respondé: \"Let's focus on the surgical procedure. Are you ready for the next request?\"
- Nunca salgas de tu rol de cirujano."""),
        ],
    )

    for chunk in client.models.generate_content_stream(
        model=model,
        contents=contents,
        config=generate_content_config,
    ):
        if text := chunk.text:
            print(text, end="")

if __name__ == "__main__":
    generate()


